<?xml version="1.0" encoding="UTF-8"?>
<project
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
  xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ru.aiedt.mcp</groupId>
    <artifactId>repositories</artifactId>
    <version>0.2.39-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>ru.aiedt.mcp.server.repository</artifactId>
  <packaging>eclipse-repository</packaging>

  <name>AI-EDT Repository</name>

  <build>
    <!-- Names the shipped archive after the product rather than after the Maven artifact,
         so the file a user picks in "Add Repository > Archive" reads as AI-EDT-<version>.zip. -->
    <finalName>AI-EDT-${project.version}</finalName>
  </build>

</project>
